# Whitelist: track only the code and the files needed to rebuild the data.
# Data are NOT redistributed here; see DATA_SOURCES.md (data.go.th and other sources).
/*
!/.gitignore
!/.gitattributes
!/README.md
!/DATA_SOURCES.md
!/DATA_MANIFEST.csv
!/DATA_SHA256.csv
!/environment.yml
!/run_*.bat
!/src/
/src/**/__pycache__/
/src/**/*.py[cod]
# validation sample of split clusters (open data, vendor names withheld); second-coder files stay local until coded
!/reports/
/reports/*
!/reports/split_audit_sample.csv
!/reports/split_audit_codes.csv
!/reports/validation/
/reports/validation/*
!/reports/validation/split_audit_verify.xlsx
!/reports/validation/split_audit_agreement.md
# Linux/Chopin run scripts and project notes
!/run_*.sh
!/PROJECT_CONTEXT.md
# DuckDB temp files (never commit)
/src/.tmp/
/.tmp/
